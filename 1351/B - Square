import sys
input = sys.stdin.readline
 
t = int(input())
 
for _ in range(t):
    a1, b1 = map(int, input().split())
    a2, b2 = map(int, input().split())
    
    max1, min1 = max(a1, b1), min(a1, b1)
    max2, min2 = max(a2, b2), min(a2, b2)
    
    if max1 == max2 and min1 + min2 == max1:
        print("Yes")
    else:
        print("No")